# ============================================
# Snim .gitignore
# ============================================

# ============================================
# Build artifacts
# ============================================
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps
.flatpak-builder/

# ============================================
# Qt/MOC generated files
# ============================================
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm

# ============================================
# IDE/Editor files
# ============================================
# CLion
.idea/
# Per-machine CMake profiles (local toolchain/dependency paths)
CMakeUserPresets.json

# VSCode
.vscode/
*.code-workspace

# Visual Studio
.vs/

# clangd
.cache/

# Qt Creator
*.autosave

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# Temporary/Cache files
# ============================================
*.o
*.a
*.la
*.lo
*.slo
*.obj
*.gch
*.pch
*.so
*.so.*
*.dylib
*.dll
*.lai
*.class

# Core dumps (anchored to repo root so it doesn't ignore the src/core/ source dir)
/core
core.*

# Backup files
*.bak
*.backup
*.old
*.orig
*.rej

# ============================================
# OS-specific files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================
# Package managers
# ============================================
# vcpkg
vcpkg_installed/

# ============================================
# Testing artifacts
# ============================================
Testing/
DartConfiguration.tcl

# ============================================
# Logs and databases
# ============================================
*.log
*.sqlite
*.sqlite3
*.db

# ============================================
# User-specific files
# (Don't commit personal configs)
# ============================================
*.user
local_config.txt
secrets.txt
.env
.env.local

# ============================================
# Misc unnecessary files
# ============================================
*.stackdump
*.lnk
*.pdf

# Compressed files (unless specifically needed)
*.zip
*.7z
*.gz
*.bz2
*.xz

# ============================================
# Personal notes/drafts (your temporary files)
# ============================================
TODO.txt
NOTES.txt
SCRATCH.md
DRAFT*.md
WIP*.md
