<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <!-- System tray icon -->
        <file>icons/tray-icon.svg</file>

        <!-- Toolbar icons -->
        <file>icons/save.svg</file>
        <file>icons/copy.svg</file>
        <file>icons/pointer.svg</file>
        <file>icons/arrow.svg</file>
        <file>icons/text.svg</file>
        <file>icons/rectangle.svg</file>
        <file>icons/ellipse.svg</file>
        <file>icons/freehand.svg</file>
        <file>icons/highlight.svg</file>
        <file>icons/blur.svg</file>

        <!-- View controls -->
        <file>icons/fit.svg</file>
        <file>icons/actual-size.svg</file>
        <file>icons/background.svg</file>
        <file>icons/panels.svg</file>
    </qresource>
    <qresource prefix="/styles">
        <file>styles/editor.qss</file>
    </qresource>
</RCC>
