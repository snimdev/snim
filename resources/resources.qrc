<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <!-- System tray icon -->
        <file>icons/tray-icon.svg</file>

        <!-- Full-color app icon master -->
        <file>icons/app-icon.svg</file>

        <!-- Toolbar icons -->
        <file>icons/save.svg</file>
        <file>icons/play.svg</file>
        <file>icons/pause.svg</file>
        <file>icons/export-gif.svg</file>
        <file>icons/export-webp.svg</file>
        <file>icons/frame.svg</file>
        <file>icons/upload.svg</file>
        <file>icons/chevron-down.svg</file>
        <file>icons/camera.svg</file>
        <file>icons/mic.svg</file>
        <file>icons/speaker.svg</file>
        <file>icons/copy.svg</file>
        <file>icons/undo.svg</file>
        <file>icons/redo.svg</file>
        <file>icons/pointer.svg</file>
        <file>icons/arrow.svg</file>
        <file>icons/text.svg</file>
        <file>icons/rectangle.svg</file>
        <file>icons/ellipse.svg</file>
        <file>icons/freehand.svg</file>
        <file>icons/highlight.svg</file>
        <file>icons/blur.svg</file>
        <file>icons/step.svg</file>

        <!-- View controls -->
        <file>icons/fit.svg</file>
        <file>icons/actual-size.svg</file>
        <file>icons/background.svg</file>
        <file>icons/panels.svg</file>
    </qresource>
    <qresource prefix="/styles">
        <file>styles/editor.qss</file>
    </qresource>
</RCC>
